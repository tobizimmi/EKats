# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Datenbank (Postgres + PostGIS)
DATABASE_URL=postgres://ekats:ekats@localhost:5432/ekats

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# Web Push (VAPID) — Schluesselpaar erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# NASA FIRMS (kostenloser MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
# Radius um den Wehr-Kartenmittelpunkt (wehr.center_lat/center_lon), in dem Hotspots abgefragt werden
FIRMS_RADIUS_KM=50

# E-Mail-Versand (SMTP, EU-Anbieter empfohlen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EKats <no-reply@example.org>"

# Erst-Setup: Wehr + Stab-Account, den migrate/seed anlegt (nur falls DB noch leer ist)
SEED_WEHR_NAME=Freiwillige Feuerwehr Musterstadt
# Kartenmittelpunkt beim ersten Laden des Dashboards (z.B. Geraetehaus-Standort)
SEED_WEHR_LAT=50.9375
SEED_WEHR_LON=6.9603
SEED_ADMIN_EMAIL=stab@example.org
# Leer lassen, um beim Seed-Lauf ein zufaelliges Passwort generieren und einmalig ausgeben zu lassen.
SEED_ADMIN_PASSWORD=

# Scheduler-Intervalle (Standard-Cron-Ausdruecke, siehe README fuer Anpassung)
FETCH_DWD_UNWETTER_CRON=*/20 * * * *
FETCH_PEGELONLINE_CRON=*/15 * * * *
FETCH_HOCHWASSERZENTRALEN_CRON=*/20 * * * *
FETCH_FIRMS_CRON=*/45 * * * *
FETCH_WALDBRANDINDEX_CRON=0 6 * * *
FETCH_DWD_STATIONS_IMPORT_CRON=0 4 * * 1
CLEANUP_CRON=30 3 * * *
DATA_RETENTION_DAYS=14
